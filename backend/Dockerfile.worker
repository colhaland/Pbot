FROM mcr.microsoft.com/playwright/python:v1.51.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir '.[worker]'

RUN useradd --create-home --uid 10001 pbot && mkdir -p /data/artifacts && chown -R pbot:pbot /app /data
USER pbot
CMD ["python", "-m", "app.worker"]